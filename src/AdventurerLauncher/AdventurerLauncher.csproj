<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.2.4</Version>
    <AssemblyName>AventurerosLauncher</AssemblyName>
    <RootNamespace>AdventurerLauncher</RootNamespace>
    <ApplicationIcon Condition="Exists('Assets\\launcher.ico')">Assets\launcher.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\launcher.ico" />
    <Resource Include="Assets\launcher-logo.png" />
    <None Update="launcher-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
