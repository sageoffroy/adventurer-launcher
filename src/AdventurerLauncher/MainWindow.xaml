<Window x:Class="AdventurerLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Aventureros de Azeroth"
        Width="1120" Height="720"
        MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="#15110E">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#D91F1915" />
        <SolidColorBrush x:Key="BorderBrush" Color="#5A4637" />
        <SolidColorBrush x:Key="AccentBrush" Color="#C98A3D" />
        <SolidColorBrush x:Key="TextBrush" Color="#F3E8D7" />
        <SolidColorBrush x:Key="MutedBrush" Color="#B9AA98" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF6EA" />
            <Setter Property="Background" Value="#7A4B22" />
            <Setter Property="BorderBrush" Value="#D19A55" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="AVENTUREROS DE AZEROTH"
                       Foreground="{StaticResource TextBrush}"
                       FontSize="30"
                       FontWeight="Bold" />
            <TextBlock Text="Noticias, cambios y actualización del cliente"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="14"
                       Margin="1,4,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="NOTICIAS"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,14" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="NewsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#44352A" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Date}" Foreground="{StaticResource AccentBrush}" FontSize="12" Margin="0,4,0,8" />
                                            <TextBlock Text="{Binding Summary}" Foreground="{StaticResource MutedBrush}" FontSize="14" TextWrapping="Wrap" LineHeight="20" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="CHANGELOG"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="18"
                               FontWeight="Bold"
                               Margin="0,0,0,14" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="ChangelogList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="#44352A" BorderThickness="0,0,0,1" Padding="0,0,0,14" Margin="0,0,0,14">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Version, StringFormat=v{0}}" Foreground="{StaticResource TextBrush}" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Date, StringFormat=  •  {0}}" Foreground="{StaticResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl ItemsSource="{Binding Changes}" Margin="0,8,0,0">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding StringFormat=• {0}}" Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,2,0,2" TextWrapping="Wrap" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Margin="0,18,0,0"
                Background="#E61B1714"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText"
                               Text="Preparando launcher..."
                               Foreground="{StaticResource TextBrush}"
                               FontWeight="SemiBold" />
                    <TextBlock x:Name="GamePathText"
                               Text="Carpeta de WoW no seleccionada"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Margin="0,4,0,0"
                               TextTrimming="CharacterEllipsis" />
                    <ProgressBar x:Name="UpdateProgress"
                                 Height="6"
                                 Margin="0,10,18,0"
                                 Minimum="0" Maximum="100"
                                 Visibility="Collapsed" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="SelectFolderButton" Content="CARPETA WOW" Click="SelectFolderButton_Click" />
                    <Button x:Name="UpdateButton" Content="ACTUALIZAR" Click="UpdateButton_Click" IsEnabled="False" />
                    <Button x:Name="PlayButton" Content="JUGAR" Click="PlayButton_Click" IsEnabled="False" Padding="28,10" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
